<Window x:Class="PlankWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PlankWin"
        Title="PlankWin" WindowStyle="None" ResizeMode="NoResize" 
        AllowsTransparency="True" Background="Transparent" ClipToBounds="False"
        MinWidth="1" MinHeight="1"
        ShowInTaskbar="False" Topmost="True" 
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        AllowDrop="True" DragOver="OnWindowDragOver"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <local:AppIconConverter x:Key="AppIconConverter" />
        <local:AppIndicatorsConverter x:Key="AppIndicatorsConverter" />
        <local:MarginConverter x:Key="MarginConverter" />
        <local:HexToBrushConverter x:Key="HexToBrushConverter" />
        <local:SmartContrastConverter x:Key="SmartContrastConverter" />
        <local:WingGradientConverter x:Key="WingGradientConverter" />
        <local:DockMorphEngineConverter x:Key="DockMorphEngine" />

        <ItemsPanelTemplate x:Key="VerticalPanel">
            <local:AnimatedStackPanel Orientation="Vertical" HorizontalAlignment="Stretch" ClipToBounds="False"/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <local:AnimatedStackPanel Orientation="Horizontal" VerticalAlignment="Stretch" ClipToBounds="False"/>
        </ItemsPanelTemplate>

        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid ClipToBounds="False">
                            <Grid.Width>
                                <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="CellW">
                                    <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                    <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                    <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                    <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="AppearScale"/>
                                </MultiBinding>
                            </Grid.Width>
                            <Grid.Height>
                                <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="CellH">
                                    <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                    <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                    <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                    <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="AppearScale"/>
                                </MultiBinding>
                            </Grid.Height>

                            <Grid x:Name="OuterContainer" ClipToBounds="False">
                                <Border x:Name="Outer" ClipToBounds="False" Opacity="0">
                                    <Border.Background>
                                        <Binding Path="DataContext.Settings.BackgroundColor" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}" Converter="{StaticResource SmartContrastConverter}" ConverterParameter="Highlight" />
                                    </Border.Background>
                                    <Border.CornerRadius>
                                        <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="OuterRadius">
                                            <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Border.CornerRadius>
                                    <Border.Margin>
                                        <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="OuterMargin">
                                            <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Border.Margin>
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="OuterW">
                                            <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Border.Width>
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="OuterH">
                                            <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Border.Height>
                                </Border>
                            </Grid>

                            <ItemsControl x:Name="IndicatorDots" IsHitTestVisible="False" ClipToBounds="False">
                                <ItemsControl.ItemsSource>
                                    <MultiBinding Converter="{StaticResource AppIndicatorsConverter}">
                                        <Binding Path="RunningInstancesCount" />
                                        <Binding Path="IsActive" FallbackValue="False" />
                                        <Binding Path="ActiveWindowIndex" FallbackValue="-1" />
                                    </MultiBinding>
                                </ItemsControl.ItemsSource>
                                <ItemsControl.Opacity>
                                    <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="IndicatorOpacity">
                                        <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                        <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                        <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                        <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </ItemsControl.Opacity>
                                <ItemsControl.Margin>
                                    <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="IndicatorMargin">
                                        <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                        <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                        <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                        <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </ItemsControl.Margin>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2" CornerRadius="3" Background="{Binding DataContext.Settings.BackgroundColor, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}, Converter={StaticResource SmartContrastConverter},ConverterParameter='Dot'}">
                                            <Border.Effect>
                                                <BlurEffect Radius="1"/>
                                            </Border.Effect>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Width" Value="6"/>
                                                    <Setter Property="Height" Value="6"/>
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                            <Setter Property="Background" Value="{Binding DataContext.Settings.IndicatorColor, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}, Converter={StaticResource HexToBrushConverter}}"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="2" ShadowDepth="0" Color="White" Opacity="0.3"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDash}" Value="True">
                                                            <Setter Property="Width" Value="20"/>
                                                        </DataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDash}" Value="True"/>
                                                                <Condition Binding="{Binding DataContext.Settings.UIPosition, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}}" Value="Left"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Width" Value="6"/>
                                                            <Setter Property="Height" Value="20"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDash}" Value="True"/>
                                                                <Condition Binding="{Binding DataContext.Settings.UIPosition, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}}" Value="Right"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Width" Value="6"/>
                                                            <Setter Property="Height" Value="20"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid x:Name="IconGrid" ClipToBounds="False" RenderTransformOrigin="0.5,0.5"
                                  Width="{Binding DataContext.Settings.EffectiveIconSize, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}}"
                                  Height="{Binding DataContext.Settings.EffectiveIconSize, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}}">
                                <Grid.Margin>
                                    <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="IconMargin">
                                        <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                        <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                        <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                        <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Grid.Margin>
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ScaleTrans" ScaleX="1.0" ScaleY="1.0" />
                                </Grid.RenderTransform>

                                <Rectangle x:Name="ReflectionRect" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.Margin>
                                        <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="ReflectMargin">
                                            <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Rectangle.Margin>
                                    <Rectangle.Fill>
                                        <VisualBrush Visual="{Binding ElementName=IconContent}" Stretch="Fill" AlignmentX="Center" AlignmentY="Center"/>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="ReflectTransform">
                                            <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.OpacityMask>
                                        <MultiBinding Converter="{StaticResource DockMorphEngine}" ConverterParameter="ReflectMask">
                                            <Binding Path="DataContext.Settings.Thickness" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.EffectiveIconSize" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}"/>
                                            <Binding Path="(local:DockPhysics.MorphProgress)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <ContentPresenter x:Name="IconContent" ClipToBounds="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect x:Name="IconShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3" Color="Black" />
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Settings.UIPosition, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}}" Value="Bottom">
                                <Setter TargetName="Outer" Property="VerticalAlignment" Value="Bottom"/>
                                <Setter TargetName="Outer" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="IconGrid" Property="VerticalAlignment" Value="Bottom"/>
                                <Setter TargetName="IconGrid" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="IndicatorDots" Property="VerticalAlignment" Value="Bottom"/>
                                <Setter TargetName="IndicatorDots" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="IndicatorDots" Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.Settings.UIPosition, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}}" Value="Top">
                                <Setter TargetName="Outer" Property="VerticalAlignment" Value="Top"/>
                                <Setter TargetName="Outer" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="IconGrid" Property="VerticalAlignment" Value="Top"/>
                                <Setter TargetName="IconGrid" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="IndicatorDots" Property="VerticalAlignment" Value="Top"/>
                                <Setter TargetName="IndicatorDots" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="IndicatorDots" Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.Settings.UIPosition, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}}" Value="Left">
                                <Setter TargetName="Outer" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="Outer" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="IconGrid" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="IconGrid" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="IndicatorDots" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="IndicatorDots" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="IndicatorDots" Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.Settings.UIPosition, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}}" Value="Right">
                                <Setter TargetName="Outer" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Outer" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="IconGrid" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="IconGrid" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="IndicatorDots" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="IndicatorDots" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="IndicatorDots" Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DataContext.Settings.IsShelfMode, RelativeSource={RelativeSource AncestorType={x:Type local:DockItemsControl}}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(local:DockPhysics.MorphProgress)" To="1.0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="OuterContainer" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ReflectionRect" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(local:DockPhysics.MorphProgress)" To="0.0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="OuterContainer" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="ReflectionRect" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="0.9"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1.15">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleY">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="0.9"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1.15">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Outer" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Outer" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="IconShadow" Storyboard.TargetProperty="Color" To="White" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IconShadow" Storyboard.TargetProperty="ShadowDepth" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IconShadow" Storyboard.TargetProperty="BlurRadius" To="15" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IconShadow" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="IconShadow" Storyboard.TargetProperty="Color" To="Black" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IconShadow" Storyboard.TargetProperty="ShadowDepth" To="2" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IconShadow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IconShadow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ContentContainer" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False" 
          AllowDrop="True" Drop="OnPanelDrop" DragOver="OnPanelDragOver" DragLeave="OnPanelDragLeave">

        <Grid x:Name="ZoomMarginGrid" Margin="40" Background="Transparent" ClipToBounds="False">

            <Viewbox x:Name="MainViewbox" Stretch="Uniform" StretchDirection="DownOnly" ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Grid x:Name="DockGeometryGrid" ClipToBounds="False" PreviewMouseWheel="OnAppsWheel">

                    <Border x:Name="MainBorder" BorderThickness="0" ClipToBounds="False" SnapsToDevicePixels="True" ContextMenuOpening="MainBorder_ContextMenuOpening">
                        <Border.Effect>
                            <DropShadowEffect x:Name="PanelShadow" BlurRadius="16" ShadowDepth="0" Direction="0" Opacity="0.2" Color="Black" />
                        </Border.Effect>

                        <Border.Background>
                            <MultiBinding Converter="{StaticResource WingGradientConverter}">
                                <Binding Path="Settings.BackgroundColor" />
                                <Binding Path="Settings.BackgroundOpacity" />
                                <Binding Path="Settings.UIPosition" />
                                <Binding Path="Settings.UseAccentShadow" />
                                <Binding Path="Settings.AccentIntensity" />
                            </MultiBinding>
                        </Border.Background>

                        <Border.CornerRadius>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <local:SmartRadiusConverter />
                                </MultiBinding.Converter>
                                <Binding Path="Settings.PanelCornerRadius" />
                                <Binding Path="Settings.IsFloating" />
                                <Binding Path="Settings.UIPosition" />
                                <Binding Path="Settings.Thickness" />
                            </MultiBinding>
                        </Border.CornerRadius>

                        <Border BorderThickness="1.5" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#12FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.2"/>
                                    <GradientStop Color="#08000000" Offset="0.8"/>
                                    <GradientStop Color="#15000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>

                            <Border BorderThickness="0.5" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0AFFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.2"/>
                                        <GradientStop Color="#05000000" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#04FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.4"/>
                                        <GradientStop Color="#08000000" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Border>
                    <Canvas x:Name="AppsScrollHost" ClipToBounds="False" IsManipulationEnabled="True" ManipulationDelta="OnAppsManipulation">
                    <local:DockItemsControl x:Name="AppsItemsControl" ItemsSource="{Binding Apps}" ClipToBounds="False"
                                            VerticalAlignment="Top" HorizontalAlignment="Left"
                                            RenderTransformOrigin="0,0">
                        <local:DockItemsControl.RenderTransform>
                            <TranslateTransform x:Name="AppsScrollTransform"/>
                        </local:DockItemsControl.RenderTransform>
                        <local:DockItemsControl.Style>
                            <Style TargetType="local:DockItemsControl">
                                <Setter Property="ItemsPanel" Value="{StaticResource VerticalPanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Settings.UIPosition, RelativeSource={RelativeSource AncestorType=Window}}" Value="Top">
                                        <Setter Property="ItemsPanel" Value="{StaticResource HorizontalPanel}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.Settings.UIPosition, RelativeSource={RelativeSource AncestorType=Window}}" Value="Bottom">
                                        <Setter Property="ItemsPanel" Value="{StaticResource HorizontalPanel}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:DockItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="AppButton" Tag="{Binding}" Style="{StaticResource DockButtonStyle}" 
                                        Click="OnAppButtonClick" PreviewMouseWheel="OnAppButtonWheel" MouseEnter="OnAppButtonMouseEnter" MouseLeave="OnAppButtonMouseLeave" ClipToBounds="False"
                                        ContextMenuOpening="OnAppButtonContextMenuOpening"
                                        AllowDrop="True" PreviewMouseLeftButtonDown="OnIconMouseLeftButtonDown"
                                        PreviewMouseMove="OnIconMouseMove" GiveFeedback="OnIconGiveFeedback"
                                        DragOver="OnIconDragOver" Drop="OnIconDrop" DragEnter="OnIconDragEnter" DragLeave="OnIconDragLeave" 
                                        PreviewMouseUp="OnIconMouseUp" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                    <Button.ToolTip>
                                        <ToolTip Content="{Binding Name}"/>
                                    </Button.ToolTip>
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">

                                            <MenuItem Header="{Binding Name}" IsEnabled="False" FontWeight="Bold" />
                                            <Separator />

                                            <MenuItem Header="{DynamicResource L_m_newWindow}" Click="OnLaunchNewInstanceClick" Icon="&#xE8A7;"/>
                                            <MenuItem Header="{DynamicResource L_m_runAdmin}" Click="OnRunAsAdminClick" Icon="&#xE7EF;"
                                                      Visibility="{Binding RunAsAdminVisibility}"/>
                                            <MenuItem Header="{DynamicResource L_m_addFolderFav}" Tag="AddFolderFav" Click="OnAddExplorerFolderToFavClick" Icon="&#xE734;"
                                                      Visibility="Collapsed"/>
                                            <MenuItem Header="{DynamicResource L_m_recent}" Tag="Recent" Icon="&#xE81C;" Visibility="Collapsed"/>
                                            <Separator />

                                            <MenuItem Header="{DynamicResource L_m_pin}" Click="OnPinAppClick" Icon="&#xE718;">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDynamic}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>

                                            <MenuItem Header="{DynamicResource L_m_unpin}" Click="OnUnpinAppClick" Icon="&#xE77A;">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDynamic}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>

                                            <MenuItem Header="{DynamicResource L_m_minimizeAll}" Click="OnMinimizeWindowsClick" Icon="&#xE921;">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>

                                            <MenuItem Header="{DynamicResource L_m_close}" Click="OnCloseAppClick" Icon="&#xE8BB;">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>

                                            <MenuItem Header="{DynamicResource L_m_closeAll}" Click="OnCloseAllWindowsClick" Icon="&#xE8BB;" Visibility="{Binding MultipleWindowsVisibility}"/>

                                            <Separator />
                                            <MenuItem Header="{DynamicResource L_m_hide}" Click="OnHideAppClick" Foreground="#D32F2F" ToolTip="{DynamicResource L_m_hideTip}" Icon="&#xED1A;"/>

                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Margin>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <local:SmartIconMarginConverter />
                                            </MultiBinding.Converter>
                                            <Binding Path="DataContext.Settings.IconMargin" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}" />
                                            <Binding Path="DataContext.Settings.UIPosition" RelativeSource="{RelativeSource AncestorType={x:Type local:DockItemsControl}}" />
                                        </MultiBinding>
                                    </Button.Margin>
                                    <Grid>
                                        <Image Source="{Binding ActiveIconTrigger, Converter={StaticResource AppIconConverter}}" RenderOptions.BitmapScalingMode="HighQuality" Margin="2" ClipToBounds="False" Opacity="{Binding AppearOpacity}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Path Data="M 12,2 L 14.9,8.6 L 22,9.2 L 16.7,14 L 18.3,21 L 12,17.3 L 5.7,21 L 7.3,14 L 2,9.2 L 9.1,8.6 Z" Fill="#FFD54A" Stroke="#B8860B" StrokeThickness="0.6" Stretch="Uniform" Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Effect>
                                                <DropShadowEffect BlurRadius="5" ShadowDepth="1.5" Direction="270" Opacity="0.55" Color="Black"/>
                                            </Path.Effect>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <!-- Бейдж-счётчик (из заголовка окна): красная «таблетка» в правом верхнем углу иконки. -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0"
                                                MinWidth="17" Height="17" CornerRadius="8.5" Padding="4,0"
                                                Background="#E53935" BorderBrush="#40000000" BorderThickness="0.5"
                                                IsHitTestVisible="False" Opacity="{Binding AppearOpacity}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.45" Color="Black"/>
                                            </Border.Effect>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"
                                                       FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                        <Setter TargetName="AppButton" Property="Opacity" Value="0.3"/>
                                        <Setter TargetName="AppButton" Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </local:DockItemsControl>
                    </Canvas>

                    <Path x:Name="ChevronStart" Data="M 0,7 L 8,0 L 16,7" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" Opacity="0.6" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Path x:Name="ChevronEnd" Data="M 0,0 L 8,7 L 16,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" Opacity="0.6" Visibility="Collapsed" IsHitTestVisible="False"/>

                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>